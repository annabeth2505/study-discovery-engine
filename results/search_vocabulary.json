  "_meta": {
    "purpose": "Underrepresented / absent animal clades to cross-check against the animal gut WGS metagenomics catalog and to expand ENA/PubMed search robustness.",
    "gap_type_values": {
      "biological": "Genuinely understudied clade; low/no hits is a real finding for the review article.",
      "search": "Well-studied clade (often model organisms); low hits likely means OUR query missed them, not a field gap.",
      "mixed": "Partly studied; some lineages have data, many do not."
    },
    "how_to_use": "For each clade: (1) resolve scientific_name -> NCBI taxid via Entrez esearch (free), (2) query ENA tax_tree(taxid) for WGS/METAGENOMIC deposits, (3) count studies already in catalog by matching search_terms against host_* columns. Compare the three numbers.",
    "field_notes": "search_terms mixes common names (catch PubMed titles/abstracts) and scientific names (catch ENA taxonomy). tax_anchor is the best scientific name to resolve to a taxid for tax_tree() ENA queries."
  },
